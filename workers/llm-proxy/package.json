{
  "name": "selemene-llm-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
