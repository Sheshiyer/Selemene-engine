    "deploy:dry-run": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260929.1",
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=20"
  }
}
