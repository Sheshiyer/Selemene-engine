{
  "name": "selemene-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Selemene Engine ChatGPT MCP Worker (scoped, stateless, OAuth-protected)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
