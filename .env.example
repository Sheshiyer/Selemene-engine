# Noesis API - Environment Configuration
# =========================================
#
# Docker Deployment:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Change JWT_SECRET and POSTGRES_PASSWORD for production
#   3. Run:  docker-compose up
#
# Railway Deployment:
#   See scripts/railway-setup.sh or set variables in Railway Dashboard
#
# Local Development:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Start dependencies:  docker-compose up -d redis postgres
#   3. Run locally:  cargo run --bin noesis-server

# === Server Configuration ===
RUST_ENV=development
RUST_LOG=info
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# === Error Tracking (Sentry) ===
# Obtain from: https://sentry.io > Settings > Projects > selemene-engine > Client Keys
SENTRY_DSN=

# === Database Configuration ===
POSTGRES_DB=noesis
POSTGRES_USER=noesis_user
POSTGRES_PASSWORD=noesis_password
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
DATABASE_URL=postgresql://noesis_user:noesis_password@postgres:5432/noesis

# === Redis Configuration ===
REDIS_URL=redis://redis:6379
REDIS_POOL_SIZE=10

# === Cache Configuration ===
CACHE_L1_SIZE=268435456  # 256MB
CACHE_L1_TTL=3600        # 1 hour
CACHE_L2_TTL=86400       # 24 hours

# === Authentication ===
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRY=3600  # 1 hour

# === Swiss Ephemeris ===
SWISS_EPHEMERIS_PATH=/app/data/ephemeris

# === Data Paths ===
DATA_PATH=/app/data
WISDOM_DOCS_PATH=/app/data/wisdom-docs
# Allowlisted root containing filesystem `rendered_reading` artifacts (for example, the 723 archive root).
# Invitation creation and recipient delivery fail closed when this is unset or invalid.
LIVING_READING_ARTIFACT_ROOT=/app/data/living-readings-723
# UTF-8 publication body cap. Valid range: 1-8388608 bytes; default: 2097152.
LIVING_READING_PUBLICATION_MAX_BYTES=2097152

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# === Feature Flags ===
ENABLE_METRICS=true
ENABLE_WITNESS=true

# === Vedic Runtime ===
# Selemene's Vedic engines (panchanga, vimshottari, transits, charts) run as
# native Rust against bundled Swiss Ephemeris data. No external Vedic provider
# key is required.

# === Database Configuration ===
# Production: Railway Postgres. Local: Docker Postgres from docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/noesis

# === Cloudflare Zero Trust ===
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=your-cloudflare-access-audience-tag
# Comma-separated exact emails promoted only after CF JWT verification.
CF_PLATFORM_ADMIN_EMAILS=
# Development only. Honored only when RUST_ENV=development.
CF_DEV_BYPASS_TOKEN=local-dev-platform-admin-token

# === Cloudflare R2 for Raaga Clips ===
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_RAGA_CLIPS_BUCKET=selemene-raga-clips
R2_PUBLIC_BASE_URL=https://raga-clips.example.com

# === Default Admin Credentials (Initial Setup) ===
# Created by: cargo run --package noesis-auth --features postgres --example seed_api_keys
# ADMIN_EMAIL=admin@tryambakam.com
# ADMIN_PASSWORD=<generated-by-seed-script>
# Admin API Keys: see seed script output (5 keys across enterprise/premium/free tiers)
# === Python Sidecar Services ===
# URL for the biofield CV sidecar (FastAPI on port 8002)
# Local dev:    PYTHON_BIOFIELD_URL=http://localhost:8002
# Railway prod: PYTHON_BIOFIELD_URL=http://biofield-cv-service.railway.internal:8002
PYTHON_BIOFIELD_URL=http://localhost:8002

# === Dodo Payments ===
# Get keys from: https://app.dodopayments.com/developers (test mode by default)
# Leaving these unset disables the billing integration; the API runs as before.
#
# Required for ANY Dodo wiring:
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENV=test                       # "test" or "live" — validated at startup
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/billing?status=success

# Required only after Wave 1.2 (dashboard provisioning) — the IDs Dodo issues for
# the products, credit entitlement, and usage meter we create in their dashboard.
DODO_PRODUCT_FREE_ID=
DODO_PRODUCT_BASIC_ID=
DODO_PRODUCT_PREMIUM_ID=
DODO_ENTITLEMENT_WITNESS_CREDITS_ID=
DODO_METER_ENGINE_QUERY_ID=

# Shared secret used by the Next.js webhook adaptor to authenticate calls into
# the Rust internal billing endpoint. Generate with `openssl rand -base64 48`.
DODO_INTERNAL_FORWARD_SECRET=


# NVIDIA NIM — Sigil Forge image generation
# Get key from https://build.nvidia.com (free tier available)
NVIDIA_API_KEY=nvapi-your_key_here
