# Noesis API - Environment Configuration
# =========================================
#
# Docker Deployment:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Change JWT_SECRET and POSTGRES_PASSWORD for production
#   3. Run:  docker-compose up
#
# Railway Deployment:
#   See scripts/railway-setup.sh or set variables in Railway Dashboard
#
# Local Development:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Start dependencies:  docker-compose up -d redis postgres
#   3. Run locally:  cargo run --bin noesis-server

# === Server Configuration ===
RUST_ENV=development
RUST_LOG=info
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# === Error Tracking (Sentry) ===
# Obtain from: https://sentry.io > Settings > Projects > selemene-engine > Client Keys
SENTRY_DSN=

# === Database Configuration ===
POSTGRES_DB=noesis
POSTGRES_USER=noesis_user
POSTGRES_PASSWORD=noesis_password
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
DATABASE_URL=postgresql://noesis_user:noesis_password@postgres:5432/noesis

# === Redis Configuration ===
REDIS_URL=redis://redis:6379
REDIS_POOL_SIZE=10

# === Cache Configuration ===
CACHE_L1_SIZE=268435456  # 256MB
CACHE_L1_TTL=3600        # 1 hour
CACHE_L2_TTL=86400       # 24 hours

# === Authentication ===
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRY=3600  # 1 hour

# === Swiss Ephemeris ===
SWISS_EPHEMERIS_PATH=/app/data/ephemeris

# === Data Paths ===
DATA_PATH=/app/data
WISDOM_DOCS_PATH=/app/data/wisdom-docs

# === Rate Limiting ===
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# === Feature Flags ===
ENABLE_METRICS=true
ENABLE_WITNESS=true

# === Vedic Runtime ===
# Selemene's Vedic engines (panchanga, vimshottari, transits, charts) run as
# native Rust against bundled Swiss Ephemeris data. No external Vedic provider
# key is required.

# === Supabase Configuration ===
# Obtain from: https://supabase.com/dashboard/project/_/settings/database
SUPABASE_DB_PASSWORD=your_supabase_password_here

# === Default Admin Credentials (Initial Setup) ===
# Created by: cargo run --package noesis-auth --features postgres --example seed_api_keys
# ADMIN_EMAIL=admin@tryambakam.com
# ADMIN_PASSWORD=<generated-by-seed-script>
# Admin API Keys: see seed script output (5 keys across enterprise/premium/free tiers)
# === Python Sidecar Services ===
# URL for the biofield CV sidecar (FastAPI on port 8002)
# Local dev:    PYTHON_BIOFIELD_URL=http://localhost:8002
# Railway prod: PYTHON_BIOFIELD_URL=http://biofield-cv-service.railway.internal:8002
PYTHON_BIOFIELD_URL=http://localhost:8002
