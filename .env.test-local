RUST_ENV=development
RUST_LOG=info,noesis_api=debug
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DATABASE_URL=postgresql://noesis_user:noesis_password@localhost:5432/noesis
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10
JWT_SECRET=dev_secret_change_me_in_production_1234567890abcdef
JWT_EXPIRY=3600
CACHE_L1_SIZE=268435456
CACHE_L1_TTL=3600
CACHE_L2_TTL=86400
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60
ENABLE_METRICS=true
ENABLE_WITNESS=true
DATA_PATH=./data
