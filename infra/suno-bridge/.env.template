# Suno bridge — env template
# Copy this to .env (gitignored) and fill the SUNO_COOKIE value yourself.
# DO NOT commit .env or paste the cookie into chat / issues / commit messages.
#
# After filling, deploy via: ./deploy.sh

# Your Suno session cookie (from suno.com → DevTools → Network → Request Headers → cookie:)
# This is sensitive — guard it like a password. It expires every 7-30 days; refresh per
# infra/suno-bridge/SUNO_AUTH_RUNBOOK.md when you see 401s.
SUNO_COOKIE=

# Optional: pin a specific gcui-art/suno-api commit/tag for reproducibility.
# If unset, deploy uses HEAD of main on your fork (more risky — upstream can break auth).
SUNO_API_PIN=v1.0.0
