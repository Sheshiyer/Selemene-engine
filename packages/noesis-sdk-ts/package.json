{
  "name": "@noesis/sdk",
  "version": "3.3.0",
  "description": "TypeScript SDK for Noesis Consciousness Engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
