{
  "name": "@selemene/engine-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client SDK for the 4 focus consciousness engines (biofield, face-reading, raaga, sigil-forge) with FROZEN media contracts (image_data, consent, generated_image/generated_audio) and local-first consent enforcement",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.contract-tests.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "selemene",
    "noesis",
    "engine-sdk",
    "biofield",
    "face-reading",
    "raaga",
    "sigil-forge",
    "frozen-contracts",
    "consent",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
