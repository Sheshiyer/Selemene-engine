{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.tryambakam.org/contracts/v1/engine-capability.schema.json",
  "title": "Selemene Engine Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "engine_id",
    "display_name",
    "availability",
    "runtime_kind",
    "dependencies"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "availability": {
      "enum": [
        "declared",
        "available",
        "degraded",
        "unavailable"
      ]
    },
    "runtime_kind": {
      "enum": [
        "native",
        "typescript",
        "python",
        "database-conditional",
        "composed"
      ]
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?::[a-z0-9-]+)*$",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "reason_code": {
      "enum": [
        "NOT_OBSERVED",
        "REGISTERED",
        "CAPABILITY_AVAILABLE",
        "CAPABILITY_DEGRADED",
        "CAPABILITY_UNAVAILABLE",
        "REQUIRED_DEPENDENCY_UNAVAILABLE",
        "OPTIONAL_DEPENDENCY_UNAVAILABLE",
        "DEPENDENCY_UNAVAILABLE",
        "DATABASE_UNCONFIGURED",
        "MODULE_UNAVAILABLE",
        "TIMEOUT",
        "MALFORMED_OBSERVATION",
        "OPERATION_UNSUPPORTED"
      ]
    },
    "dependency_observations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "dependency_kind",
          "requirement",
          "availability",
          "reason_code"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?::[a-z0-9-]+)*$",
            "minLength": 1,
            "maxLength": 80
          },
          "dependency_kind": {
            "enum": [
              "rust",
              "typescript",
              "python",
              "database",
              "network",
              "filesystem"
            ]
          },
          "requirement": {
            "enum": [
              "required",
              "optional"
            ]
          },
          "availability": {
            "enum": [
              "declared",
              "available",
              "degraded",
              "unavailable"
            ]
          },
          "reason_code": {
            "enum": [
              "NOT_OBSERVED",
              "REGISTERED",
              "CAPABILITY_AVAILABLE",
              "CAPABILITY_DEGRADED",
              "CAPABILITY_UNAVAILABLE",
              "REQUIRED_DEPENDENCY_UNAVAILABLE",
              "OPTIONAL_DEPENDENCY_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE",
              "DATABASE_UNCONFIGURED",
              "MODULE_UNAVAILABLE",
              "TIMEOUT",
              "MALFORMED_OBSERVATION",
              "OPERATION_UNSUPPORTED"
            ]
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculate",
        "validate",
        "witness_eligible"
      ],
      "properties": {
        "calculate": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "validate": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "witness_eligible": {
          "type": "boolean"
        }
      }
    },
    "required_phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "implementation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
