{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noesis.tryambakam.org/engines/sacred-geometry/geometry.schema.json",
  "title": "Sacred Geometry construction data (result.geometry)",
  "description": "Numeric construction data for one sacred form (GH #1524). Coordinates are relative: centred on the origin, y up, and inside the unit circle. The engine returns numbers only; clients draw them. result.geometry is null for forms whose construction is not implemented, and result.provenance_detail.calculated_geometry gives the reason.",
  "type": ["object", "null"],
  "additionalProperties": false,
  "required": [
    "unit",
    "frame",
    "construction",
    "circles",
    "polygons",
    "polylines",
    "lines",
    "points",
    "measures"
  ],
  "properties": {
    "unit": { "const": "relative" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "radius", "y_axis"],
      "properties": {
        "center": { "$ref": "#/$defs/point2" },
        "radius": { "const": 1 },
        "y_axis": { "const": "up" }
      }
    },
    "construction": { "type": "string", "minLength": 1 },
    "circles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cx", "cy", "r"],
        "properties": {
          "cx": { "type": "number" },
          "cy": { "type": "number" },
          "r": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "polygons": {
      "type": "array",
      "items": { "$ref": "#/$defs/pointList" }
    },
    "polylines": {
      "type": "array",
      "items": { "$ref": "#/$defs/pointList" }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x1", "y1", "x2", "y2"],
        "properties": {
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" }
        }
      }
    },
    "points": {
      "type": "array",
      "items": { "$ref": "#/$defs/point2" }
    },
    "measures": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "solid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices", "edges", "view_axis"],
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/point3" }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          }
        },
        "view_axis": { "$ref": "#/$defs/point3" }
      }
    }
  },
  "$defs": {
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "pointList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point2" }
        }
      }
    }
  }
}
