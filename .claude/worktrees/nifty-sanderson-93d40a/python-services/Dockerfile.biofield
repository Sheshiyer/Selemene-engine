FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY shared/ shared/
COPY biofield_cv_service/ biofield_cv_service/

RUN pip install --no-cache-dir -e .

EXPOSE 8002

CMD ["uvicorn", "biofield_cv_service.main:app", "--host", "0.0.0.0", "--port", "8002"]
