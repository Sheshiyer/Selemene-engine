FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY shared/ shared/
COPY mediapipe_service/ mediapipe_service/

RUN pip install --no-cache-dir -e ".[mediapipe]"

EXPOSE 8001

CMD ["uvicorn", "mediapipe_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
