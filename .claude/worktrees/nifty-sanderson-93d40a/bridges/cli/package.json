{
  "name": "@selemene/bridge",
  "version": "3.0.0",
  "description": "CLI tool for setting up Selemene Engine agent bridges — Claude, OpenAI, LangChain",
  "type": "module",
  "bin": {
    "selemene-bridge": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "selemene",
    "ai",
    "tools",
    "claude",
    "openai",
    "langchain",
    "agent",
    "bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
