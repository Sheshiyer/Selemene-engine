# =============================================================================
# Selemene-engine — Supabase Retirement Cutover Secrets Worksheet
# =============================================================================
# Purpose: Fill in the placeholder values for YOUR account, then hand each
# completed block back to the agent. The agent will set them on the Railway
# Selemene-engine service one block at a time and verify.
#
# DO NOT commit this file with real secret values. .gitignore already
# ignores .exampleenv. Keep this file local only.
#
# Format: KEY=value  (no quotes unless the value contains spaces/special chars)
# Replace every <PLACEHOLDER: ...> with your real value.
# =============================================================================


# =============================================================================
# BLOCK 1 — Cloudflare Zero Trust (CF Access identity)
# =============================================================================
# Where to find: Cloudflare dashboard → Zero Trust → Access → Applications
#   - Find (or create) the application protecting selemene.tryambakam.space
#   - Issuer  = your team'sCF Access URL
#   - Audience = the Application Audience ID (a UUID)
#
# The Rust middleware reads these to validate the CF_Authorization JWT.
# Source: crates/noesis-api/src/config.rs (CF_ACCESS_ISSUER, CF_ACCESS_AUDIENCE)

CF_ACCESS_ISSUER=red-queen-4dfa.cloudflareaccess.com
CF_ACCESS_AUDIENCE=df8a00b1d19f2e8034ed262544912656ca969fcdadf0e2599b61d4d2f687b6b4
CF_ACCOUNT_ID=9d9d23b27f32e70ae3afb6a1aa2c0f10
CF_API_TOKEN=cfat_ffplj8onwa8qLB5aJeEO4ksQLBSpsqL61ONGu97B02661d5d
CF_ACCESS_KEY_ID=8a2e33c61aa7fb9f60b0b2f3f9a0395c
CF_SECRET_ACCESS_KEY=5779a7f05c912a922db2cb16b6cf81e1b9fe193ce3316518579a25f04d58e9b4
CF_S3_API_ENDPOINT=https://9d9d23b27f32e70ae3afb6a1aa2c0f10.r2.cloudflarestorage.com

#Example Usage -curl -X GET "https://api.cloudflare.com/client/v4/accounts/9d9d23b27f32e70ae3afb6a1aa2c0f10/tokens/verify" \
     -H "Authorization: Bearer cfat_ffplj8onwa8qLB5aJeEO4ksQLBSpsqL

# Optional — local dev bypass only. Honored when RUST_ENV=development.
# Leave blank in prod. Generate with: openssl rand -base64 48
CF_DEV_BYPASS_TOKEN=<PLACEHOLDER: leave-blank-for-prod>


# =============================================================================
# BLOCK 2 — Cloudflare R2 (raaga clip asset storage)
# =============================================================================
# Where to find:
#   - R2_ACCOUNT_ID:        Cloudflare dashboard → right sidebar (account ID)
#   - R2 bucket:            R2 → Create bucket → name it `selemene-raga-clips`
#   - R2 API token:         R2 → Manage R2 API tokens → Create token
#                          (permissions: Object Read & Write, bucket: selemene-raga-clips)
#   - R2_ACCESS_KEY_ID  = token ID (starts with ...)
#   - R2_SECRET_ACCESS_KEY = token secret (shown once)
#   - R2_PUBLIC_BASE_URL = public URL for serving clips (e.g. via R2 public
#                          dev URL or a custom domain). Leave blank if you
#                          haven't set a public domain yet — uploads still work.
#
# The ts-engines raga scripts (suno-smoke, suno-bulk-gen, r2-upload) read these.
# Source: ts-engines/scripts/r2-upload.ts

R2_ACCOUNT_ID=<PLACEHOLDER: your_cloudflare_account_id>
R2_ACCESS_KEY_ID=<PLACEHOLDER: your_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<PLACEHOLDER: your_r2_secret_access_key>
# Bucket name — default is fine. Only change if you created a different bucket.
R2_RAGA_CLIPS_BUCKET=selemene-raga-clips
R2_PUBLIC_BASE_URL=<PLACEHOLDER: https://raga-clips.tryambakam.space or leave blank>


# =============================================================================
# BLOCK 3 — Dodo Payments (billing integration)
# =============================================================================
# Where to find: https://app.dodopayments.com/developers
#   - API key + webhook key: API Keys section
#   - Env: "test" first; switch to "live" when ready to charge real cards
#   - Product IDs + entitlement + meter: created in the Dodo dashboard
#     (Products → create Free, Basic, Premium; Entitlements → Witness credits;
#      Meters → engine query meter). Leave product/entitlement/meter IDs
#      BLANK until you've created them in Dodo — the API still starts without
#      them, you just can't provision users via billing.
#   - RETURN_URL: where Dodo sends the user after checkout. Use your admin-web URL.
#   - INTERNAL_FORWARD_SECRET: shared secret the Next.js webhook adaptor uses to
#     authenticate calls into Rust /internal/billing/events. Generate:
#       openssl rand -base64 48
#
# Source: crates/noesis-api/src/config.rs, apps/admin-web billing webhook

DODO_PAYMENTS_API_KEY=UF8EpkB8aA9Kcz6Q.zCTfqVz9OzmP2eEguxIYAABGM7i_DFvJ0aBv813VlLavR5np
DODO_PAYMENTS_WEBHOOK_KEY=whsec_q6lmnld/zP2iUHR2u8qqeJIHk2Xk9msP
DODO_PAYMENTS_ENV=test
DODO_PAYMENTS_RETURN_URL=<PLACEHOLDER: https://admin.tryambakam.space/billing?status=success>

DODO_PRODUCT_FREE_ID=<PLACEHOLDER: leave-blank-until-created-in-dodo>
DODO_PRODUCT_BASIC_ID=<PLACEHOLDER: leave-blank-until-created-in-dodo>
DODO_PRODUCT_PREMIUM_ID=<PLACEHOLDER: leave-blank-until-created-in-dodo>
DODO_ENTITLEMENT_WITNESS_CREDITS_ID=<PLACEHOLDER: leave-blank-until-created-in-dodo>
DODO_METER_ENGINE_QUERY_ID=<PLACEHOLDER: leave-blank-until-created-in-dodo>

# Shared secret for the /internal/billing/events carve-out (X-Forward-Secret).
DODO_INTERNAL_FORWARD_SECRET=JLlEly2b9Zs8Qwnqrrg1NikQivmMX7TBoNHIfbaxyaKbKc6B20x6Qxj56IaG+12D


# =============================================================================
# Cleanup target (not a new secret — these will be REMOVED from Railway)
# =============================================================================
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_REDIRECT_URI
# These are retired as part of the Supabase cutover and should be unset from
# the Railway Selemene-engine service after CF Access is confirmed working.
