# Unified image for both Python sidecars. The running service is chosen at
# start by SIDECAR_SERVICE (biofield_cv_service | mediapipe_service), default
# biofield_cv_service so existing deployments keep their behaviour.
#
# Why one image: Railway reads python-services/railway.toml (config-as-code)
# for every service rooted here and it overrides per-service Dockerfile
# settings. Two services cannot each own the default file, so they share it
# and differ only by one variable.
FROM python:3.11-slim

WORKDIR /app

# curl for Railway healthcheck probe; libgl1 + libglib2.0-0 for OpenCV; the
# X11/xcb libs because the mediapipe wheel depends on opencv-contrib-python
# (not the headless build), which links libxcb/libX11 at import time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgl1 libglib2.0-0 libxcb1 libx11-6 libxext6 libxrender1 libsm6 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY shared/ shared/
COPY biofield_cv_service/ biofield_cv_service/
COPY mediapipe_service/ mediapipe_service/

RUN pip install --no-cache-dir -e ".[mediapipe]"

ENV SIDECAR_SERVICE=biofield_cv_service

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

CMD ["sh", "-c", "uvicorn ${SIDECAR_SERVICE}.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
