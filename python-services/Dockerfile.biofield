FROM python:3.11-slim

WORKDIR /app

# curl for Railway healthcheck probe; libgl1 + libglib2.0-0 required by opencv-python-headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY uv.lock .
COPY shared/ shared/
COPY mediapipe_service/ mediapipe_service/
COPY biofield_cv_service/ biofield_cv_service/

RUN pip install --no-cache-dir uv==0.7.13 \
    && uv sync --locked --no-dev --no-editable --python /usr/local/bin/python

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8002}/health || exit 1

CMD ["sh", "-c", "uvicorn biofield_cv_service.main:app --host 0.0.0.0 --port ${PORT:-8002}"]
