FROM python:3.11-slim

WORKDIR /app

# curl for Railway healthcheck probe; libgl1 + libglib2.0-0 for OpenCV; the X11/xcb
# libs are required because the `mediapipe` wheel depends on opencv-contrib-python
# (not the headless build), which links libxcb/libX11 at import time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgl1 libglib2.0-0 libxcb1 libx11-6 libxext6 libxrender1 libsm6 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY shared/ shared/
COPY mediapipe_service/ mediapipe_service/

RUN pip install --no-cache-dir -e ".[mediapipe]"

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8001}/health || exit 1

CMD ["sh", "-c", "uvicorn mediapipe_service.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
