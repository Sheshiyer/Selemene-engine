FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY uv.lock .
COPY shared/ shared/
COPY biofield_cv_service/ biofield_cv_service/
COPY mediapipe_service/ mediapipe_service/

RUN pip install --no-cache-dir uv==0.7.13 \
    && uv sync --locked --extra mediapipe --no-dev --no-editable --python /usr/local/bin/python

ENV PATH="/app/.venv/bin:${PATH}"

EXPOSE 8001

CMD ["uvicorn", "mediapipe_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
