import{join,resolve}from'node:path';import{homedir}from'node:os';import{mkdir}from'node:fs/promises';import{createHash}from'node:crypto';
const root=resolve('tools/humdes-extractor/output/gary-abitbol-2026-09-28/completion-2026-10-04/notebooklm'),cli=join(homedir(),'.local/bin/notebooklm');const state=await Bun.file(join(root,'run-state.json')).json();const path=join(root,'recovery-state.json');const recovery:any=await Bun.file(path).exists()?await Bun.file(path).json():{notebooks:{},downloads:{}};
async function call(args:string[]){const p=Bun.spawn([cli,...args,'--json'],{stdout:'pipe',stderr:'pipe'});const[o,e]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text()]);if(await p.exited)throw Error(e.slice(-700)||o.slice(-700));return JSON.parse(o)}
for(const[stem,row]of Object.entries(state.notebooks) as [string,any][]){const listed=await call(['artifact','list','--notebook',row.notebookId]);recovery.notebooks[stem]={notebookId:row.notebookId,checkedAt:new Date().toISOString(),artifacts:listed.artifacts};const dir=join(root,stem,'downloads');await mkdir(dir,{recursive:true});
for(const a of listed.artifacts){if(a.status!=='completed'||recovery.downloads[a.id]?.status==='downloaded')continue;const type=({flashcards:'flashcards',slide_deck:'slide-deck',mind_map:'mind-map'}as any)[a.type_id]??a.type_id;const ext=({audio:'mp3',video:'mp4','slide-deck':'pdf',report:'md',quiz:'json',flashcards:'json','mind-map':'json'}as any)[type];if(!ext)continue;const file=join(dir,a.id+'.'+ext);try{await call(['download',type,file,'--notebook',row.notebookId,'--artifact',a.id]);const bytes=new Uint8Array(await Bun.file(file).arrayBuffer());if(!bytes.length)throw Error('Empty download');recovery.downloads[a.id]={stem,title:a.title,type,status:'downloaded',file,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex'),contentReviewed:false};console.log(JSON.stringify({stem,type,status:'downloaded',bytes:bytes.length}));}catch(e){recovery.downloads[a.id]={stem,title:a.title,status:'download-failed',error:String(e)};}await Bun.write(path,JSON.stringify(recovery,null,2));}
console.log(JSON.stringify({stem,counts:listed.artifacts.reduce((s:any,a:any)=>(s[a.status]=(s[a.status]??0)+1,s),{})}));await Bun.write(path,JSON.stringify(recovery,null,2));}
let index='# Witness Alchemist — NotebookLM assets\n\nCurated native report sources; live Jev review remains pending. Generated derivatives need separate content review. Original downloads are preserved. A separately reviewed Gary study-guide copy is linked where available.\n\n';for(const[stem,row]of Object.entries(recovery.notebooks)as[string,any][]){index+=`## ${stem}\n\n[Open notebook](https://notebooklm.google.com/notebook/${row.notebookId})\n\n`;for(const a of row.artifacts){const d=recovery.downloads[a.id];index+=`- ${a.title} — ${a.status}${d?.status==='downloaded'?` — [original download](${d.file})`:''}${d?.reviewedFile?` — [reviewed copy](${d.reviewedFile})`:''}\n`;}index+='\n';}await Bun.write(join(root,'INDEX.md'),index);console.log(JSON.stringify({notebooks:Object.keys(recovery.notebooks).length,downloaded:Object.values(recovery.downloads).filter((d:any)=>d.status==='downloaded').length}));
