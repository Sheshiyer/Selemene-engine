import {resolve,join} from 'node:path';import{mkdir}from'node:fs/promises';import{createHash}from'node:crypto';import{homedir}from'node:os';
const root=resolve('tools/humdes-extractor/output/gary-abitbol-2026-09-28/completion-2026-10-04');const cli=join(homedir(),'.local/bin/notebooklm'),out=join(root,'notebooklm');await mkdir(out,{recursive:true});
const delivery=await Bun.file(join(root,'delivery-manifest.json')).json();const statePath=join(out,'run-state.json');let state:any=await Bun.file(statePath).exists()?await Bun.file(statePath).json():{route:'Native-report adaptation of Witness premium assets',notebooks:{},jevExecuted:false,finalAccepted:false};
const save=()=>Bun.write(statePath,JSON.stringify(state,null,2));
async function call(args:string[],env?:Record<string,string>){const p=Bun.spawn([cli,...args,'--json'],{stdout:'pipe',stderr:'pipe',env:{...process.env,...env}});const [stdout,stderr]=await Promise.all([new Response(p.stdout).text(),new Response(p.stderr).text()]);const code=await p.exited;if(code)throw Error(stderr.slice(-1200)||stdout.slice(-1200));return JSON.parse(stdout)}
function id(x:any):string|undefined{return x?.id??x?.notebook_id??x?.notebook?.id??x?.source_id??x?.source?.id??x?.task_id??x?.artifact_id??x?.artifact?.id}
const assets=[['audio','deep-dive-long',['--format','deep-dive','--length','long'],'Explain distinct lenses, convergence, meaningful tensions and grounded practices as a warm conversation.'],['video','video-brief',['--format','brief'],'Accessible introduction to the integrated reading.'],['slide-deck','detailed',['--format','detailed'],'Detailed integrated personal or business reading deck; explain systems first, then braid domains.'],['slide-deck','preview',['--format','presenter','--length','short'],'Short preview: scope, three contours, a reflection, closing.'],['slide-deck','vimshottari-timeline',['--format','detailed'],'Only the saved Vimshottari chronology, preserving dates and birth uncertainty. Distinguish periods from predictions.'],['report','study-guide',['--format','study-guide'],'Study guide to understand the report and use reflection questions.'],['report','briefing',['--format','briefing-doc'],'Accessible briefing of the central contours and limits.'],['quiz','quiz',['--difficulty','medium','--quantity','standard'],'Reflective self-knowledge quiz, no compatibility score or personality diagnosis.'],['flashcards','flashcards',[],'Study cards distinguishing system vocabulary, chart data and interpretation.'],['mind-map','mind-map',[],'Integrated contours and systems, without fusing different measurements.']] as const;
for(const r of delivery.reports){const stem=r.stem,dir=join(out,stem);await mkdir(dir,{recursive:true});const text=await Bun.file(join(root,r.files.markdown)).text();const sha=createHash('sha256').update(text).digest('hex');if(sha!==r.sha256.markdown||!r.structuralPass)throw Error('Unreviewed report '+stem);
const policy=`# Witness Alchemist companion — ${r.subject}, ${r.language.toUpperCase()}\n\nAudience: ${r.subject}. Mode: ${stem.startsWith('business')?'three equal business partners with pairwise comparisons and supplied Penta':'personal integrated reflection'}. Language: ${r.language}.\n\nRead the report as distinct symbolic lenses, convergence, meaningful differences, and braided life domains. Calculation disagreements require factual reconciliation. Do not invent unavailable Western chart details, personal history, clinical states, financial outcomes, Penta job assignments, or compatibility scores. All chronology is the saved calculation, not a fresh current transit reading.\n\nGary’s Western tropical Sun is Aquarius. The supplied Vedic Lahiri sidereal chart records Sun at 11°00′05″ Capricorn. These use different coordinate conventions; never describe Gary as Capricorn without the explicit sidereal qualification. A complete Western tropical chart has not been supplied. Gary’s birth time remains approximate.\n\nWarm, precise Aletheios-style differentiation and Pichet-style experiential invitations. Neither agent grants authority over the recipient. Use optional grounded questions. Visual style: parchment, soft gold, night indigo, restrained editorial typography.\n\nThese are native editorially reviewed sources; live Jev verification remains pending. Derivative generation does not constitute Jev or product acceptance.\n`;
await Bun.write(join(dir,'companion-policy.md'),policy);await Bun.write(join(dir,'integrated-reading.md'),text);
let row=state.notebooks[stem];if(row&&row.sourceSha256!==sha)throw Error('Source changed; explicit versioning required '+stem);if(!row){const c=await call(['create',`Witness Alchemist — ${r.subject} — ${r.language.toUpperCase()} — 2026-10-04`]);const notebookId=id(c);if(!notebookId)throw Error('Missing notebook ID');row=state.notebooks[stem]={notebookId,sourceSha256:sha,sources:{},assets:{},language:r.language};await save();console.log(JSON.stringify({stem,notebookId,stage:'created'}));}
for(const file of ['integrated-reading.md','companion-policy.md'])if(!row.sources[file]){const res=await call(['source','add',join(dir,file),'--notebook',row.notebookId,'--title',file.replace('.md','')]);const sourceId=id(res);if(!sourceId)throw Error('Missing source ID');row.sources[file]=sourceId;await save();}
for(const sourceId of Object.values(row.sources) as string[]){const p=Bun.spawn([cli,'source','wait',sourceId,'--notebook',row.notebookId,'--timeout','60'],{stdout:'pipe',stderr:'pipe'});await new Response(p.stdout).text();const err=await new Response(p.stderr).text();if(await p.exited)throw Error(err);}
for(const [type,label,options,description]of assets){if(row.assets[label])continue;const prompt=`Output in ${r.language==='fr'?'French':'English'} for ${r.subject}. ${description} Follow companion-policy.md and cite the integrated-reading source. Do not invent new chart data.`;let args=['generate',type,...options,'--notebook',row.notebookId];if(type==='mind-map')args.push('--instructions',prompt,'--language',r.language);else if(type==='quiz'||type==='flashcards')args.push(prompt);else args.push('--language',r.language,...(type==='report'?['--append',prompt]:[prompt]));
try{const response=await call(args,{NOTEBOOKLM_HL:r.language});row.assets[label]={type,status:'submitted',response,artifactId:id(response)};console.log(JSON.stringify({stem,asset:label,status:'submitted'}));}catch(e){row.assets[label]={type,status:'failed',error:String(e)};console.log(JSON.stringify({stem,asset:label,status:'failed',error:String(e)}));}await save();}
}
console.log(JSON.stringify({stage:'all-submissions-attempted',notebooks:Object.keys(state.notebooks).length}));
